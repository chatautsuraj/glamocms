generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local default: sqlite (file:./dev.db). Docker/Render entrypoint switches to postgresql.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderChannel {
  store
  website
  whatsapp
  phone
}

enum PaymentStatus {
  unpaid
  paid
  partial
  cancelled
}

enum FulfillmentStatus {
  pending
  confirmed
  packed
  out_for_delivery
  delivered
  cancelled
}

model Product {
  id          String      @id @default(cuid())
  name        String
  sku         String      @unique
  price       Decimal
  /// Average / last purchase cost for margin reports
  costPrice   Decimal     @default(0)
  stock       Int         @default(0)
  category    String?
  images      String      @default("[]")
  brand       String?
  shade       String?
  batchNumber String?
  expiresOn   DateTime?
  isTester    Boolean     @default(false)
  size        String?
  mrp         Decimal?
  reorderAt   Int         @default(5)
  galla       Boolean     @default(true)
  vatApplicable Boolean   @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  stockAdjustments StockAdjustment[]
  purchaseLines PurchaseLine[]
  returnLines SaleReturnLine[]
}

model Customer {
  id            String        @id @default(cuid())
  name          String
  phone         String?
  email         String?
  sourceChannel OrderChannel?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]

  @@index([phone])
}

model Order {
  id                   String            @id @default(cuid())
  customerId           String?
  customer             Customer?         @relation(fields: [customerId], references: [id])
  amount               Decimal
  paymentStatus        PaymentStatus     @default(unpaid)
  fulfillmentStatus    FulfillmentStatus @default(pending)
  channel              OrderChannel
  deliveryAssignee     String?
  deliveryAddress      String?
  deliveryNotes        String?
  deliveryScheduledAt  DateTime?
  deliveryPartner      String?
  deliveryExternalId   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  items                OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Decimal
  lineTotal Decimal
}

/// Cashier till / shift for open–close reconciliation
model TillShift {
  id           String    @id @default(cuid())
  cashierName  String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingFloat Decimal   @default(0)
  closingCash  Decimal?
  expectedCash Decimal?
  notes        String?
  status       String    @default("open") // open | closed
}

/// Stock adjustments with reason (stocktake / damage / receive)
model StockAdjustment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  delta     Int
  reason    String
  note      String?
  createdAt DateTime @default(now())
}

/// Purchase receipts (supplier receiving)
model PurchaseReceipt {
  id           String   @id @default(cuid())
  supplierName String
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())
  lines        PurchaseLine[]
}

model PurchaseLine {
  id        String          @id @default(cuid())
  receiptId String
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  qty       Int
  unitCost  Decimal         @default(0)
}

/// Partial or full return against a sold order (restocks inventory)
model SaleReturn {
  id        String          @id @default(cuid())
  orderId   String
  amount    Decimal
  reason    String?
  createdAt DateTime        @default(now())
  lines     SaleReturnLine[]
}

model SaleReturnLine {
  id        String     @id @default(cuid())
  returnId  String
  return    SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  qty       Int
}

/// Fonepay / QR payment confirmations (manual confirm or webhook)
model PaymentConfirmation {
  id          String   @id @default(cuid())
  orderId     String?
  provider    String   @default("fonepay")
  externalRef String?
  amount      Decimal  @default(0)
  status      String   @default("confirmed") // pending | confirmed | failed
  raw         String?
  createdAt   DateTime @default(now())
}
