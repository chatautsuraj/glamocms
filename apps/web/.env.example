# GLAMO POS — copy to .env.local for development. All values are public
# (inlined into the browser bundle at build time); never put secrets here.

# GLAMO Nepal Hono API origin (no trailing /api/v1).
# Production: https://api.glamonepal.com   Local backend: http://localhost:3001
NEXT_PUBLIC_API_URL=https://api.glamonepal.com

# Firebase web config — SAME project and variable names as the glamonepal.com
# storefront (Google sign-in). Defaults to the shared GLAMO project if unset.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
